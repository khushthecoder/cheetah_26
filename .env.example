# Where Ollama is listening (the Vite dev server proxies /ollama -> this URL)
OLLAMA_URL=http://127.0.0.1:11434
# Open-weight model used for extraction. Must support images for photo input.
VITE_MODEL=gemma4:e2b-it-qat
# Production builds only: where the visitor's browser reaches Ollama. Default: http://localhost:11434
# VITE_OLLAMA_BASE_URL=http://localhost:11434
